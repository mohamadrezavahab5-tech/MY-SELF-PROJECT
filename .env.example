# Copy the values you need into your host's environment variables panel.
NODE_ENV=production
PORT=3000

# Your domain, with https and no trailing slash. Used in links, SEO and payment callbacks.
SITE_URL=https://example.ir
SITE_NAME=پاسخ‌یار
SITE_NAME_EN=Pasokhyar

# Where the SQLite database lives. Point this at a persistent disk.
DATA_DIR=/data

# Your own mobile number(s), comma-separated: these accounts get the admin panel.
ADMIN_PHONES=09120000000

# Zarinpal merchant id (from the Zarinpal panel). Leave empty until you have one:
# in production the checkout then shows "coming soon" instead of taking payments.
ZARINPAL_MERCHANT=
# Optional: zarinpal | sandbox | disabled
# PAYMENT_MODE=sandbox

# Shown in the footer.
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=
# Paste the eNamad / Zarinpal trust badge HTML here once you have it.
TRUST_BADGES_HTML=

# Affiliate program.
REFERRAL_COMMISSION_PERCENT=25
REFERRAL_DISCOUNT_PERCENT=10
MIN_PAYOUT_TOMAN=200000
